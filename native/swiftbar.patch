diff --git a/SwiftBar/MenuBar/NativeUsageChart.swift b/SwiftBar/MenuBar/NativeUsageChart.swift
new file mode 100644
index 0000000..8a4f689
--- /dev/null
+++ b/SwiftBar/MenuBar/NativeUsageChart.swift
@@ -0,0 +1,178 @@
+import AppKit
+import Charts
+import SwiftUI
+
+/// Inline, base64-encoded JSON supplied by a plugin's `nativechart` parameter.
+/// The host renders data only: it never reads credentials, files, or URLs.
+struct NativeUsageChartData: Decodable {
+    struct Point: Decodable {
+        let at: Double
+        let remaining: Double
+        let reset: Double?
+        let segment: Int
+    }
+
+    struct Series: Decodable, Identifiable {
+        let id: String
+        let label: String
+        let provider: String
+        let span: Double
+        let window: Double?
+        let points: [Point]
+    }
+
+    let now: Double
+    let series: [Series]
+
+    static func decode(_ encoded: String) -> Self? {
+        guard let data = Data(base64Encoded: encoded),
+              let decoded = try? JSONDecoder().decode(Self.self, from: data),
+              decoded.series.allSatisfy({ $0.span > 0 && $0.points.allSatisfy { (0...100).contains($0.remaining) } })
+        else { return nil }
+        return decoded
+    }
+}
+
+@available(macOS 13.0, *)
+struct NativeUsageChart: View {
+    let data: NativeUsageChartData
+    @State private var selectedID: String?
+    @State private var fullHistory = false
+
+    private func color(_ series: NativeUsageChartData.Series) -> Color {
+        switch series.provider {
+        case "codex": return .blue
+        case "claude": return .orange
+        default: return .purple
+        }
+    }
+
+    var body: some View {
+        let selected = data.series.first(where: { $0.id == selectedID }) ?? data.series.first
+        VStack(alignment: .leading, spacing: 10) {
+            Picker("Limit", selection: Binding(
+                get: { selected?.id ?? "" }, set: { selectedID = $0 }
+            )) {
+                ForEach(data.series) { Text($0.label).tag($0.id) }
+            }
+            .labelsHidden()
+            .controlSize(.small)
+
+            Picker("Range", selection: $fullHistory) {
+                Text("Current period").tag(false)
+                Text("History").tag(true)
+            }
+            .labelsHidden()
+            .pickerStyle(.segmented)
+            .controlSize(.small)
+
+            if let series = selected {
+                let reset = series.points.last?.reset
+                let hasPeriod = reset != nil && (series.window ?? 0) > 0 && reset! > data.now
+                let end = !fullHistory && hasPeriod ? reset! : data.now
+                let start = !fullHistory && hasPeriod ? end - series.window! : data.now - series.span
+                let points = series.points.filter {
+                    $0.at >= start && $0.at <= end && (fullHistory || !hasPeriod || $0.reset == reset)
+                }
+                let counts = Dictionary(grouping: points, by: \.segment).mapValues(\.count)
+                Chart {
+                    if !fullHistory && hasPeriod {
+                        ForEach([start, end], id: \.self) { at in
+                            LineMark(
+                                x: .value("Time", Date(timeIntervalSince1970: at)),
+                                y: .value("Remaining", at == start ? 100.0 : 0.0),
+                                series: .value("Series", "Ideal")
+                            )
+                            .foregroundStyle(Color(nsColor: .secondaryLabelColor))
+                            .lineStyle(StrokeStyle(lineWidth: 1, dash: [4, 3]))
+                        }
+                    }
+                    ForEach(Array(points.enumerated()), id: \.offset) { _, point in
+                        LineMark(
+                            x: .value("Time", Date(timeIntervalSince1970: point.at)),
+                            y: .value("Remaining", point.remaining),
+                            series: .value("Series", "Observed-\(point.segment)")
+                        )
+                        .foregroundStyle(color(series))
+                        .lineStyle(StrokeStyle(lineWidth: 1))
+                        if counts[point.segment] == 1 && point.at != points.last?.at {
+                            PointMark(
+                                x: .value("Time", Date(timeIntervalSince1970: point.at)),
+                                y: .value("Remaining", point.remaining)
+                            )
+                            .foregroundStyle(color(series))
+                            .symbolSize(10)
+                        }
+                    }
+                    if let point = points.last {
+                        PointMark(
+                            x: .value("Time", Date(timeIntervalSince1970: point.at)),
+                            y: .value("Remaining", point.remaining)
+                        )
+                        .foregroundStyle(color(series))
+                        .symbolSize(35)
+                    }
+                }
+                .chartXScale(domain: Date(timeIntervalSince1970: start)...Date(timeIntervalSince1970: end))
+                .chartYScale(domain: 0...100)
+                .chartYAxis { AxisMarks(values: [0, 50, 100]) }
+                .chartXAxis(.hidden)
+                .chartLegend(.hidden)
+                .frame(height: 110)
+                .accessibilityLabel("\(series.label), usage remaining")
+
+                HStack {
+                    VStack(alignment: .leading, spacing: 2) {
+                        Text(Date(timeIntervalSince1970: start), format: .dateTime.month().day())
+                        Text(Date(timeIntervalSince1970: start), format: .dateTime.hour().minute())
+                    }
+                    Spacer()
+                    VStack(alignment: .trailing, spacing: 2) {
+                        Text(Date(timeIntervalSince1970: end), format: .dateTime.month().day())
+                        Text(Date(timeIntervalSince1970: end), format: .dateTime.hour().minute())
+                    }
+                }
+                .font(.caption2)
+                .foregroundStyle(.secondary)
+                if let latest = points.last {
+                    Text("\(Int(latest.remaining.rounded()))% remaining")
+                        .font(.caption)
+                        .foregroundStyle(.secondary)
+                } else {
+                    Text("No recorded readings").font(.caption)
+                }
+            } else {
+                Text("No current readings").font(.caption)
+            }
+        }
+        .foregroundStyle(.primary)
+        .padding(.horizontal, 16)
+        .padding(.vertical, 10)
+        .frame(width: 220, height: 240)
+    }
+}
+
+enum NativeUsageChartHost {
+    @MainActor static func makeTextView(title: String, size: CGFloat) -> NSView {
+        let view = NSHostingView(rootView:
+            Text(title.trimmingCharacters(in: .whitespaces))
+                .font(.system(size: size))
+                .foregroundStyle(.primary)
+                .frame(width: 200, alignment: .leading)
+                .fixedSize(horizontal: false, vertical: true)
+                .padding(.horizontal, 10)
+                .padding(.vertical, 2)
+        )
+        view.identifier = NSUserInterfaceItemIdentifier("nativeInfoRow")
+        view.setFrameSize(view.fittingSize)
+        return view
+    }
+
+    @MainActor static func makeView(encoded: String) -> NSView? {
+        guard #available(macOS 13.0, *), let data = NativeUsageChartData.decode(encoded) else { return nil }
+        let view = NSHostingView(rootView: NativeUsageChart(data: data))
+        view.identifier = NSUserInterfaceItemIdentifier("nativeUsageChart")
+        view.frame = NSRect(x: 0, y: 0, width: 220, height: 240)
+        return view
+    }
+}
