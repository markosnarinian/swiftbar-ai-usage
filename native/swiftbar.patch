diff --git a/SwiftBar/MenuBar/NativeUsageChart.swift b/SwiftBar/MenuBar/NativeUsageChart.swift
new file mode 100644
index 0000000..84d8ab7
--- /dev/null
+++ b/SwiftBar/MenuBar/NativeUsageChart.swift
@@ -0,0 +1,188 @@
+import AppKit
+import Charts
+import SwiftUI
+
+/// Inline, base64-encoded JSON supplied by a plugin's `nativechart` parameter.
+/// The host renders data only: it never reads credentials, files, or URLs.
+struct NativeUsageChartData: Decodable {
+    struct Point: Decodable {
+        let at: Double
+        let remaining: Double
+        let segment: Int
+    }
+
+    struct Series: Decodable, Identifiable {
+        let id: String
+        let label: String
+        let provider: String
+        let span: Double
+        let points: [Point]
+
+        var shortLabel: String {
+            label.replacingOccurrences(of: "weekly", with: "wk")
+                .replacingOccurrences(of: " (monthly)", with: "")
+        }
+    }
+
+    let now: Double
+    let series: [Series]
+
+    static func decode(_ encoded: String) -> Self? {
+        guard let data = Data(base64Encoded: encoded),
+              let decoded = try? JSONDecoder().decode(Self.self, from: data),
+              decoded.series.allSatisfy({ $0.span > 0 && $0.points.allSatisfy { (0...100).contains($0.remaining) } })
+        else { return nil }
+        return decoded
+    }
+}
+
+@available(macOS 13.0, *)
+struct NativeUsageChart: View {
+    let data: NativeUsageChartData
+    @State private var hovered: String?
+
+    private func color(_ series: NativeUsageChartData.Series) -> Color {
+        switch series.provider {
+        case "codex": return .blue
+        case "claude": return .orange
+        default: return .purple
+        }
+    }
+
+    private func dash(_ series: NativeUsageChartData.Series) -> [CGFloat] {
+        if series.span <= 18000 { return [] }
+        return series.id == "amp_orb" ? [1, 2] : [4, 2]
+    }
+
+    var body: some View {
+        VStack(alignment: .leading, spacing: 6) {
+            Text(hovered ?? "Remaining · %")
+                .font(.system(size: 10, weight: .medium))
+                .lineLimit(1)
+                .frame(height: 13, alignment: .leading)
+
+            HStack {
+                Text("7d")
+                Spacer()
+                Text("3.5d")
+                Spacer()
+                Text("Now")
+            }
+            .font(.system(size: 9))
+            .padding(.leading, 24)
+
+            Chart {
+                ForEach(data.series) { series in
+                    ForEach(Array(series.points.enumerated()), id: \.offset) { _, point in
+                        LineMark(
+                            x: .value("History", (point.at - data.now) / series.span),
+                            y: .value("Remaining", point.remaining),
+                            series: .value("Segment", "\(series.id)-\(point.segment)")
+                        )
+                        .foregroundStyle(color(series))
+                        .lineStyle(StrokeStyle(lineWidth: 1.5, dash: dash(series)))
+                    }
+                    if let point = series.points.last {
+                        PointMark(
+                            x: .value("History", (point.at - data.now) / series.span),
+                            y: .value("Remaining", point.remaining)
+                        )
+                        .foregroundStyle(color(series))
+                        .symbolSize(10)
+                    }
+                }
+            }
+            .chartXScale(domain: -1.0...0.025)
+            .chartYScale(domain: -2.0...102.0)
+            .chartYAxis {
+                AxisMarks(position: .leading, values: [0, 50, 100]) {
+                    AxisGridLine()
+                    AxisValueLabel().font(.system(size: 9))
+                }
+            }
+            .chartXAxis(.hidden)
+            .chartLegend(.hidden)
+            .chartOverlay { proxy in
+                GeometryReader { geometry in
+                    Rectangle().fill(.clear).contentShape(Rectangle())
+                        .onContinuousHover { phase in
+                            switch phase {
+                            case let .active(location):
+                                let origin = geometry[proxy.plotAreaFrame].origin
+                                guard let x: Double = proxy.value(atX: location.x - origin.x),
+                                      let y: Double = proxy.value(atY: location.y - origin.y)
+                                else { hovered = nil; return }
+                                let candidates = data.series.flatMap { series in
+                                    series.points.map { point in
+                                        (series, point, abs((point.at-data.now)/series.span-x)*100 + abs(point.remaining-y))
+                                    }
+                                }
+                                if let (series, point, _) = candidates.min(by: { $0.2 < $1.2 }) {
+                                    let date = Date(timeIntervalSince1970: point.at)
+                                    hovered = "\(series.shortLabel) \(Int(point.remaining.rounded()))% · \(date.formatted(.dateTime.day().month().hour().minute()))"
+                                }
+                            case .ended: hovered = nil
+                            }
+                        }
+                }
+            }
+            .accessibilityLabel("Usage remaining. Session limits use the lower five-hour axis; weekly and monthly limits use the upper seven-day axis.")
+
+            HStack {
+                Text("5h")
+                Spacer()
+                Text("2.5h")
+                Spacer()
+                Text("Now")
+            }
+            .font(.system(size: 9))
+            .padding(.leading, 24)
+
+            LazyVGrid(columns: [GridItem(.flexible(), alignment: .leading), GridItem(.flexible(), alignment: .leading)], alignment: .leading, spacing: 3) {
+                ForEach(data.series) { series in
+                    HStack(spacing: 4) {
+                        Path { path in
+                            path.move(to: .init(x: 0, y: 4))
+                            path.addLine(to: .init(x: 12, y: 4))
+                        }
+                        .stroke(color(series), style: StrokeStyle(lineWidth: 1.5, dash: dash(series)))
+                        .frame(width: 12, height: 8)
+                        Text(series.shortLabel).font(.system(size: 9)).lineLimit(1)
+                    }
+                    .help(series.label + (series.span <= 18000 ? " · lower 5h axis" : " · upper 7d axis"))
+                }
+            }
+            if data.series.isEmpty {
+                Text("No current readings").font(.caption)
+            }
+        }
+        .foregroundStyle(.primary)
+        .padding(10)
+        .frame(width: 220, height: 240)
+    }
+}
+
+enum NativeUsageChartHost {
+    @MainActor static func makeTextView(title: String, size: CGFloat) -> NSView {
+        let view = NSHostingView(rootView:
+            Text(title.trimmingCharacters(in: .whitespaces))
+                .font(.system(size: size))
+                .foregroundStyle(.primary)
+                .frame(width: 200, alignment: .leading)
+                .fixedSize(horizontal: false, vertical: true)
+                .padding(.horizontal, 10)
+                .padding(.vertical, 2)
+        )
+        view.identifier = NSUserInterfaceItemIdentifier("nativeInfoRow")
+        view.setFrameSize(view.fittingSize)
+        return view
+    }
+
+    @MainActor static func makeView(encoded: String) -> NSView? {
+        guard #available(macOS 13.0, *), let data = NativeUsageChartData.decode(encoded) else { return nil }
+        let view = NSHostingView(rootView: NativeUsageChart(data: data))
+        view.identifier = NSUserInterfaceItemIdentifier("nativeUsageChart")
+        view.frame = NSRect(x: 0, y: 0, width: 220, height: 240)
+        return view
+    }
+}
